{
  "name": "dhaka-tesla-pool",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @tesla/api && npm run build --workspace @tesla/web",
    "lint": "eslint apps --max-warnings 0 && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "migrate": "npm run migrate --workspace @tesla/api",
    "seed": "npm run seed --workspace @tesla/api",
    "dev:api": "npm run dev --workspace @tesla/api",
    "dev:web": "npm run dev --workspace @tesla/web"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
